rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      // Application access requires Firebase Authentication, not a users profile.
      return request.auth != null;
    }
    match /users/{userId} {
      function validUser(d) {
        return d.keys().hasAll(['email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
          && d.email is string && d.email.size() > 0 && d.email.size() <= 254
          && d.displayName is string && d.displayName.size() <= 200
          && d.role in ['admin', 'member'] && d.active is bool
          && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function validSupplier(data) {
      return data.keys().hasAll(['name', 'contactName', 'email', 'phone', 'postalCode', 'address', 'notes', 'active', 'createdAt', 'updatedAt', 'archivedAt'])
        && data.keys().hasOnly(['name', 'contactName', 'email', 'phone', 'postalCode', 'address', 'notes', 'active', 'createdAt', 'updatedAt', 'archivedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.contactName is string && data.contactName.size() <= 200
        && data.email is string && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 50
        && data.postalCode is string && data.postalCode.size() <= 20
        && data.address is string && data.address.size() <= 1000
        && data.notes is string && data.notes.size() <= 5000
        && data.active is bool && data.createdAt is timestamp
        && data.updatedAt == request.time
        && ((data.active && data.archivedAt == null) || (!data.active && data.archivedAt is timestamp));
    }

    match /suppliers/{supplierId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validSupplier(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.active == true;
      allow update: if isSignedIn() && validSupplier(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.active
          || (resource.data.active && request.resource.data.archivedAt == request.time)
          || (!resource.data.active && request.resource.data.archivedAt == resource.data.archivedAt));
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      // Customers and suppliers share the same contact and lifecycle fields.
      allow create: if isSignedIn() && validSupplier(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.active == true;
      allow update: if isSignedIn() && validSupplier(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.active
          || (resource.data.active && request.resource.data.archivedAt == request.time)
          || (!resource.data.active && request.resource.data.archivedAt == resource.data.archivedAt));
      allow delete: if false;
    }

    match /products/{productId} {
      function validProduct() {
        let d = request.resource.data;
        return d.keys().hasAll(['manufacturerId', 'manufacturerName', 'partNumber', 'normalizedPartNumber', 'name', 'janCode', 'category', 'unit', 'notes', 'active', 'createdAt', 'updatedAt', 'archivedAt'])
          && d.keys().hasOnly(['manufacturerId', 'manufacturerName', 'partNumber', 'normalizedPartNumber', 'name', 'janCode', 'category', 'unit', 'notes', 'active', 'createdAt', 'updatedAt', 'archivedAt'])
          && d.manufacturerId is string && d.manufacturerName is string && d.manufacturerName.size() > 0 && d.manufacturerName.size() <= 200
          && d.partNumber is string && d.partNumber.size() > 0 && d.partNumber.size() <= 200
          && d.normalizedPartNumber is string && d.normalizedPartNumber.size() > 0 && d.normalizedPartNumber.size() <= 600
          && d.name is string && d.name.size() > 0 && d.name.size() <= 500
          && d.janCode is string && (d.janCode == '' || d.janCode.matches('[0-9]{8}|[0-9]{13}'))
          && d.category is string && d.category.size() <= 200 && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 50
          && d.notes is string && d.notes.size() <= 5000 && d.active is bool && d.createdAt is timestamp && d.updatedAt == request.time
          && ((d.active && d.archivedAt == null) || (!d.active && d.archivedAt is timestamp));
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validProduct() && request.resource.data.createdAt == request.time && request.resource.data.active;
      allow update: if isSignedIn() && validProduct() && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.active || (resource.data.active && request.resource.data.archivedAt == request.time) || (!resource.data.active && request.resource.data.archivedAt == resource.data.archivedAt));
      allow delete: if false;
    }
    function validRfq(data) {
      return data.keys().hasOnly(['rfqNumber', 'customerId', 'customerName', 'subject', 'receivedAt', 'dueDate', 'requestedDeliveryDate', 'status', 'assignedUserId', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['rfqNumber', 'customerId', 'customerName', 'subject', 'receivedAt', 'dueDate', 'requestedDeliveryDate', 'status', 'assignedUserId', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.rfqNumber is string && data.rfqNumber.matches('RFQ-[0-9]{4}-[0-9]{6}')
        && data.customerId is string && data.customerId.size() > 0 && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 500 && data.receivedAt is timestamp
        && (data.dueDate == null || data.dueDate is timestamp) && (data.requestedDeliveryDate == null || data.requestedDeliveryDate is timestamp)
        && data.status in ['received', 'sourcing', 'quoting', 'quoted', 'ordered', 'purchasing', 'received_goods', 'delivered', 'completed', 'cancelled']
        && data.assignedUserId is string && data.assignedUserId.size() <= 128 && data.note is string && data.note.size() <= 5000
        && data.createdAt is timestamp && data.updatedAt == request.time && data.createdBy is string && data.updatedBy == request.auth.uid;
    }
    match /rfqs/{rfqId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validRfq(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && validRfq(request.resource.data) && request.resource.data.rfqNumber == resource.data.rfqNumber && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /rfqs/{rfqId}/itemCounters/{counterId} {
      function validCounter() {
        let d = request.resource.data;
        return counterId == 'sequence'
          && exists(/databases/$(database)/documents/rfqs/$(rfqId))
          && d.keys().hasAll(['lastLineNo', 'updatedAt'])
          && d.keys().hasOnly(['lastLineNo', 'updatedAt'])
          && d.lastLineNo is int && d.lastLineNo > 0 && d.lastLineNo <= 2147483647
          && d.updatedAt == request.time;
      }
      allow get: if isSignedIn();
      allow create: if isSignedIn() && validCounter() && request.resource.data.lastLineNo == 1;
      allow update: if isSignedIn() && validCounter()
        && request.resource.data.lastLineNo == resource.data.lastLineNo + 1;
      allow list, delete: if false;
    }
    match /rfqs/{rfqId}/items/{itemId} {
      function validItem(d) {
        return d.keys().hasAll(['lineNo', 'originalDescription', 'translatedDescription', 'productId', 'manufacturerId', 'manufacturerName', 'partNumber', 'productName', 'quantity', 'unit', 'requestedDeliveryDate', 'status', 'note', 'createdAt', 'updatedAt', 'archivedAt'])
          && d.keys().hasOnly(['lineNo', 'originalDescription', 'translatedDescription', 'productId', 'manufacturerId', 'manufacturerName', 'partNumber', 'productName', 'quantity', 'unit', 'requestedDeliveryDate', 'status', 'note', 'createdAt', 'updatedAt', 'archivedAt'])
          && d.lineNo is int && d.lineNo > 0
          && d.originalDescription is string && d.originalDescription.size() > 0 && d.originalDescription.size() <= 5000
          && d.translatedDescription is string && d.translatedDescription.size() <= 5000
          && d.productId is string && d.productId.size() <= 128
          && d.manufacturerId is string && d.manufacturerId.size() <= 128
          && d.manufacturerName is string && d.manufacturerName.size() <= 200
          && d.partNumber is string && d.partNumber.size() <= 200
          && d.productName is string && d.productName.size() <= 500
          && d.quantity is number && d.quantity > 0 && d.quantity <= 1000000000
          && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 50
          && (d.requestedDeliveryDate == null || d.requestedDeliveryDate is timestamp)
          && d.status in ['pending', 'sourcing', 'quoted', 'ordered', 'received', 'cancelled']
          && d.note is string && d.note.size() <= 5000
          && d.createdAt is timestamp && d.updatedAt == request.time
          && (d.archivedAt == null || d.archivedAt is timestamp);
      }
      function validNewLine() {
        let counterPath = /databases/$(database)/documents/rfqs/$(rfqId)/itemCounters/sequence;
        return getAfter(counterPath).data.updatedAt == request.time
          && request.resource.data.lineNo == getAfter(counterPath).data.lastLineNo
          && ((!exists(counterPath) && request.resource.data.lineNo == 1)
            || (exists(counterPath) && request.resource.data.lineNo == get(counterPath).data.lastLineNo + 1));
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/rfqs/$(rfqId))
        && validItem(request.resource.data) && validNewLine()
        && request.resource.data.createdAt == request.time && request.resource.data.archivedAt == null;
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/rfqs/$(rfqId))
        && validItem(request.resource.data)
        && request.resource.data.lineNo == resource.data.lineNo
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.archivedAt == null && request.resource.data.archivedAt == null)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivedAt', 'updatedAt'])
            && (request.resource.data.archivedAt == null || request.resource.data.archivedAt == request.time)));
      allow delete: if false;
    }
    match /supplierQuoteRequests/{requestId} {
      function validSupplierQuoteRequest(d) {
        return d.keys().hasAll(['rfqId', 'supplierId', 'supplierName', 'rfqItemIds', 'requestedAt', 'responseDueDate', 'status', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.keys().hasOnly(['rfqId', 'supplierId', 'supplierName', 'rfqItemIds', 'requestedAt', 'responseDueDate', 'status', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.rfqId is string && d.rfqId.size() > 0 && exists(/databases/$(database)/documents/rfqs/$(d.rfqId))
          && d.supplierId is string && d.supplierId.size() > 0 && exists(/databases/$(database)/documents/suppliers/$(d.supplierId))
          && d.supplierName is string && d.supplierName.size() > 0 && d.supplierName.size() <= 200
          && d.rfqItemIds is list && d.rfqItemIds.size() > 0 && d.rfqItemIds.size() <= 30
          && (d.requestedAt == null || d.requestedAt is timestamp)
          && (d.responseDueDate == null || d.responseDueDate is timestamp)
          && (d.requestedAt == null || d.responseDueDate == null || d.responseDueDate >= d.requestedAt)
          && d.status in ['draft', 'requested', 'partially_answered', 'answered', 'cancelled']
          && (d.status == 'draft' || d.requestedAt is timestamp)
          && d.note is string && d.note.size() <= 5000
          && d.createdAt is timestamp && d.createdBy is string
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validSupplierQuoteRequest(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && validSupplierQuoteRequest(request.resource.data)
        && request.resource.data.rfqId == resource.data.rfqId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
    match /rfqCounters/{year} {
      function validCounter() {
        let d = request.resource.data;
        return year.matches('[0-9]{4}')
          && d.keys().hasAll(['year', 'nextSequence', 'updatedAt'])
          && d.keys().hasOnly(['year', 'nextSequence', 'updatedAt'])
          && d.year == year && d.nextSequence is int
          && d.nextSequence > 0 && d.nextSequence <= 999999
          && d.updatedAt == request.time;
      }
      allow get: if isSignedIn();
      allow create: if isSignedIn() && validCounter() && request.resource.data.nextSequence == 1;
      allow update: if isSignedIn() && validCounter()
        && request.resource.data.nextSequence == resource.data.nextSequence + 1;
      allow delete, list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
