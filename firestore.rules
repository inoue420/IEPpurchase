rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      // Application access requires Firebase Authentication, not a users profile.
      return request.auth != null;
    }
    match /auditLogs/{logId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      function validUser(d) {
        return d.keys().hasAll(['email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
          && d.email is string && d.email.size() > 0 && d.email.size() <= 254
          && d.displayName is string && d.displayName.size() <= 200
          && d.role in ['admin', 'member'] && d.active is bool
          && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function validSupplier(data) {
      return data.keys().hasAll(['name', 'contactName', 'email', 'phone', 'postalCode', 'address', 'notes', 'active', 'createdAt', 'updatedAt', 'archivedAt'])
        && data.keys().hasOnly(['name', 'contactName', 'email', 'phone', 'postalCode', 'address', 'notes', 'active', 'createdAt', 'updatedAt', 'archivedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.contactName is string && data.contactName.size() <= 200
        && data.email is string && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 50
        && data.postalCode is string && data.postalCode.size() <= 20
        && data.address is string && data.address.size() <= 1000
        && data.notes is string && data.notes.size() <= 5000
        && data.active is bool && data.createdAt is timestamp
        && data.updatedAt == request.time
        && ((data.active && data.archivedAt == null) || (!data.active && data.archivedAt is timestamp));
    }

    match /suppliers/{supplierId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validSupplier(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.active == true;
      allow update: if isSignedIn() && validSupplier(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.active
          || (resource.data.active && request.resource.data.archivedAt == request.time)
          || (!resource.data.active && request.resource.data.archivedAt == resource.data.archivedAt));
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      // Customers and suppliers share the same contact and lifecycle fields.
      allow create: if isSignedIn() && validSupplier(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.active == true;
      allow update: if isSignedIn() && validSupplier(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.active
          || (resource.data.active && request.resource.data.archivedAt == request.time)
          || (!resource.data.active && request.resource.data.archivedAt == resource.data.archivedAt));
      allow delete: if false;
    }

    match /products/{productId} {
      function validProduct() {
        let d = request.resource.data;
        return d.keys().hasAll(['manufacturerId', 'manufacturerName', 'partNumber', 'normalizedPartNumber', 'name', 'janCode', 'category', 'unit', 'notes', 'active', 'createdAt', 'updatedAt', 'archivedAt'])
          && d.keys().hasOnly(['manufacturerId', 'manufacturerName', 'partNumber', 'normalizedPartNumber', 'name', 'janCode', 'category', 'unit', 'notes', 'active', 'createdAt', 'updatedAt', 'archivedAt'])
          && d.manufacturerId is string && d.manufacturerName is string && d.manufacturerName.size() > 0 && d.manufacturerName.size() <= 200
          && d.partNumber is string && d.partNumber.size() > 0 && d.partNumber.size() <= 200
          && d.normalizedPartNumber is string && d.normalizedPartNumber.size() > 0 && d.normalizedPartNumber.size() <= 600
          && d.name is string && d.name.size() > 0 && d.name.size() <= 500
          && d.janCode is string && (d.janCode == '' || d.janCode.matches('[0-9]{8}|[0-9]{13}'))
          && d.category is string && d.category.size() <= 200 && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 50
          && d.notes is string && d.notes.size() <= 5000 && d.active is bool && d.createdAt is timestamp && d.updatedAt == request.time
          && ((d.active && d.archivedAt == null) || (!d.active && d.archivedAt is timestamp));
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validProduct() && request.resource.data.createdAt == request.time && request.resource.data.active;
      allow update: if isSignedIn() && validProduct() && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.active || (resource.data.active && request.resource.data.archivedAt == request.time) || (!resource.data.active && request.resource.data.archivedAt == resource.data.archivedAt));
      allow delete: if false;
    }
    function validRfq(data) {
      return data.keys().hasOnly(['rfqNumber', 'customerId', 'customerName', 'subject', 'receivedAt', 'dueDate', 'requestedDeliveryDate', 'status', 'assignedUserId', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['rfqNumber', 'customerId', 'customerName', 'subject', 'receivedAt', 'dueDate', 'requestedDeliveryDate', 'status', 'assignedUserId', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && data.rfqNumber is string && data.rfqNumber.matches('RFQ-[0-9]{4}-[0-9]{6}')
        && data.customerId is string && data.customerId.size() > 0 && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 500 && data.receivedAt is timestamp
        && (data.dueDate == null || data.dueDate is timestamp) && (data.requestedDeliveryDate == null || data.requestedDeliveryDate is timestamp)
        && data.status in ['received', 'sourcing', 'quoting', 'quoted', 'ordered', 'purchasing', 'received_goods', 'delivered', 'completed', 'cancelled']
        && data.assignedUserId is string && data.assignedUserId.size() <= 128 && data.note is string && data.note.size() <= 5000
        && data.createdAt is timestamp && data.updatedAt == request.time && data.createdBy is string && data.updatedBy == request.auth.uid;
    }
    match /rfqs/{rfqId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validRfq(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && validRfq(request.resource.data) && request.resource.data.rfqNumber == resource.data.rfqNumber && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /rfqs/{rfqId}/itemCounters/{counterId} {
      function validCounter() {
        let d = request.resource.data;
        return counterId == 'sequence'
          && exists(/databases/$(database)/documents/rfqs/$(rfqId))
          && d.keys().hasAll(['lastLineNo', 'updatedAt'])
          && d.keys().hasOnly(['lastLineNo', 'updatedAt'])
          && d.lastLineNo is int && d.lastLineNo > 0 && d.lastLineNo <= 2147483647
          && d.updatedAt == request.time;
      }
      allow get: if isSignedIn();
      allow create: if isSignedIn() && validCounter() && request.resource.data.lastLineNo == 1;
      allow update: if isSignedIn() && validCounter()
        && request.resource.data.lastLineNo == resource.data.lastLineNo + 1;
      allow list, delete: if false;
    }
    match /rfqs/{rfqId}/items/{itemId} {
      function validItem(d) {
        return d.keys().hasAll(['lineNo', 'originalDescription', 'translatedDescription', 'productId', 'manufacturerId', 'manufacturerName', 'partNumber', 'productName', 'quantity', 'unit', 'requestedDeliveryDate', 'status', 'note', 'createdAt', 'updatedAt', 'archivedAt'])
          && d.keys().hasOnly(['lineNo', 'originalDescription', 'translatedDescription', 'productId', 'manufacturerId', 'manufacturerName', 'partNumber', 'productName', 'quantity', 'unit', 'requestedDeliveryDate', 'status', 'note', 'createdAt', 'updatedAt', 'archivedAt'])
          && d.lineNo is int && d.lineNo > 0
          && d.originalDescription is string && d.originalDescription.size() > 0 && d.originalDescription.size() <= 5000
          && d.translatedDescription is string && d.translatedDescription.size() <= 5000
          && d.productId is string && d.productId.size() <= 128
          && d.manufacturerId is string && d.manufacturerId.size() <= 128
          && d.manufacturerName is string && d.manufacturerName.size() <= 200
          && d.partNumber is string && d.partNumber.size() <= 200
          && d.productName is string && d.productName.size() <= 500
          && d.quantity is number && d.quantity > 0 && d.quantity <= 1000000000
          && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 50
          && (d.requestedDeliveryDate == null || d.requestedDeliveryDate is timestamp)
          && d.status in ['pending', 'sourcing', 'quoted', 'ordered', 'received', 'cancelled']
          && d.note is string && d.note.size() <= 5000
          && d.createdAt is timestamp && d.updatedAt == request.time
          && (d.archivedAt == null || d.archivedAt is timestamp);
      }
      function validNewLine() {
        let counterPath = /databases/$(database)/documents/rfqs/$(rfqId)/itemCounters/sequence;
        return getAfter(counterPath).data.updatedAt == request.time
          && request.resource.data.lineNo == getAfter(counterPath).data.lastLineNo
          && ((!exists(counterPath) && request.resource.data.lineNo == 1)
            || (exists(counterPath) && request.resource.data.lineNo == get(counterPath).data.lastLineNo + 1));
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && exists(/databases/$(database)/documents/rfqs/$(rfqId))
        && validItem(request.resource.data) && validNewLine()
        && request.resource.data.createdAt == request.time && request.resource.data.archivedAt == null;
      allow update: if isSignedIn() && exists(/databases/$(database)/documents/rfqs/$(rfqId))
        && validItem(request.resource.data)
        && request.resource.data.lineNo == resource.data.lineNo
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.archivedAt == null && request.resource.data.archivedAt == null)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivedAt', 'updatedAt'])
            && (request.resource.data.archivedAt == null || request.resource.data.archivedAt == request.time)));
      allow delete: if false;
    }
    match /supplierQuoteRequests/{requestId} {
      function validSupplierQuoteRequest(d) {
        return d.keys().hasAll(['rfqId', 'supplierId', 'supplierName', 'rfqItemIds', 'requestedAt', 'responseDueDate', 'status', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.keys().hasOnly(['rfqId', 'supplierId', 'supplierName', 'rfqItemIds', 'requestedAt', 'responseDueDate', 'status', 'note', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.rfqId is string && d.rfqId.size() > 0 && exists(/databases/$(database)/documents/rfqs/$(d.rfqId))
          && d.supplierId is string && d.supplierId.size() > 0 && exists(/databases/$(database)/documents/suppliers/$(d.supplierId))
          && d.supplierName is string && d.supplierName.size() > 0 && d.supplierName.size() <= 200
          && d.rfqItemIds is list && d.rfqItemIds.size() > 0 && d.rfqItemIds.size() <= 30
          && (d.requestedAt == null || d.requestedAt is timestamp)
          && (d.responseDueDate == null || d.responseDueDate is timestamp)
          && (d.requestedAt == null || d.responseDueDate == null || d.responseDueDate >= d.requestedAt)
          && d.status in ['draft', 'requested', 'partially_answered', 'answered', 'cancelled']
          && (d.status == 'draft' || d.requestedAt is timestamp)
          && d.note is string && d.note.size() <= 5000
          && d.createdAt is timestamp && d.createdBy is string
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validSupplierQuoteRequest(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && validSupplierQuoteRequest(request.resource.data)
        && request.resource.data.rfqId == resource.data.rfqId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
    match /supplierQuotes/{quoteId} {
      function validSupplierQuote(d) {
        return d.keys().hasAll(['rfqId', 'supplierId', 'supplierName', 'requestId', 'quoteNumber', 'quoteDate', 'validUntil', 'documentId', 'subtotal', 'tax', 'total', 'status', 'note', 'revision', 'archivedAt', 'archivedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.keys().hasOnly(['rfqId', 'supplierId', 'supplierName', 'requestId', 'quoteNumber', 'quoteDate', 'validUntil', 'documentId', 'subtotal', 'tax', 'total', 'status', 'note', 'revision', 'archivedAt', 'archivedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'itemCount', 'shippingTotal', 'lastItemId'])
          && d.rfqId is string && d.rfqId.size() > 0 && exists(/databases/$(database)/documents/rfqs/$(d.rfqId))
          && d.supplierId is string && d.supplierId.size() > 0 && exists(/databases/$(database)/documents/suppliers/$(d.supplierId))
          && d.supplierName is string && d.supplierName.size() > 0 && d.supplierName.size() <= 200
          && (d.requestId == null || (d.requestId is string && exists(/databases/$(database)/documents/supplierQuoteRequests/$(d.requestId)) && get(/databases/$(database)/documents/supplierQuoteRequests/$(d.requestId)).data.rfqId == d.rfqId && get(/databases/$(database)/documents/supplierQuoteRequests/$(d.requestId)).data.supplierId == d.supplierId))
          && d.quoteNumber is string && d.quoteNumber.size() > 0 && d.quoteNumber.size() <= 200
          && (d.quoteDate == null || d.quoteDate is timestamp) && (d.validUntil == null || d.validUntil is timestamp) && (d.quoteDate == null || d.validUntil == null || d.validUntil >= d.quoteDate)
          && (d.documentId == null || (d.documentId is string && d.documentId.size() <= 128))
          && d.subtotal is int && d.tax is int && d.total is int && d.subtotal >= 0 && d.tax >= 0 && d.total == d.subtotal + d.tax && d.total <= 1000000000000
          && d.status in ['draft', 'valid', 'withdrawn'] && d.note is string && d.note.size() <= 5000 && d.revision is int && d.revision > 0 && d.archivedAt == null && d.archivedBy == null
          && d.createdAt is timestamp && d.createdBy is string && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
      }

      function headerHistory(d) {
        let h = getAfter(/databases/$(database)/documents/supplierQuotes/$(quoteId)/revisions/$(string(d.revision))).data;
        return h.snapshot == d && h.previousSnapshot == resource.data
          && h.createdAt == request.time && h.createdBy == request.auth.uid;
      }
      function totalsDelta(d, headerBefore) {
        let path = /databases/$(database)/documents/supplierQuotes/$(quoteId)/items/$(d.lastItemId);
        let next = getAfter(path).data;
        let previous = exists(path) ? get(path).data : {'subtotal': 0, 'tax': 0, 'total': 0, 'shippingTotal': 0};
        let managed = headerBefore.get('itemCount', 0) > 0;
        return next.updatedAt == request.time && next.updatedBy == request.auth.uid
          && (!exists(path) || next.revision == get(path).data.revision + 1)
          && d.itemCount == headerBefore.get('itemCount', 0) + (exists(path) ? 0 : 1)
          && d.subtotal == (managed ? headerBefore.subtotal : 0) - previous.subtotal + next.subtotal
          && d.tax == (managed ? headerBefore.tax : 0) - previous.tax + next.tax
          && d.total == (managed ? headerBefore.total : 0) - previous.total + next.total
          && d.shippingTotal == headerBefore.get('shippingTotal', 0) - previous.shippingTotal + next.shippingTotal;
      }
      function managedUpdate(d) {
        let changed = d.diff(resource.data).affectedKeys();
        return d.itemCount is int && d.itemCount > 0
          && d.shippingTotal is int && d.shippingTotal >= 0 && d.shippingTotal <= d.total
          && d.lastItemId is string && d.lastItemId.size() > 0 && d.lastItemId.size() <= 128
          && d.supplierId == resource.data.supplierId && d.requestId == resource.data.requestId
          && ((!changed.hasAny(['subtotal', 'tax', 'total', 'shippingTotal', 'itemCount', 'lastItemId'])
                && resource.data.get('itemCount', 0) > 0)
            || (changed.hasOnly(['subtotal', 'tax', 'total', 'shippingTotal', 'itemCount', 'lastItemId', 'revision', 'updatedAt', 'updatedBy'])
                && resource.data.status != 'withdrawn' && totalsDelta(d, resource.data)));
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validSupplierQuote(request.resource.data)
        && !request.resource.data.keys().hasAny(['itemCount', 'shippingTotal', 'lastItemId'])
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid && request.resource.data.revision == 1;
      allow update: if isSignedIn() && validSupplierQuote(request.resource.data)
        && request.resource.data.rfqId == resource.data.rfqId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1
        && headerHistory(request.resource.data)
        && ((request.resource.data.keys().hasAll(['itemCount', 'shippingTotal', 'lastItemId']) && managedUpdate(request.resource.data))
          || (!resource.data.keys().hasAny(['itemCount', 'shippingTotal', 'lastItemId'])
            && !request.resource.data.keys().hasAny(['itemCount', 'shippingTotal', 'lastItemId'])));
      allow delete: if false;
      match /revisions/{revisionId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn()
          && revisionId == string(request.resource.data.revision)
          && getAfter(/databases/$(database)/documents/supplierQuotes/$(quoteId)).data.revision == request.resource.data.revision
          && getAfter(/databases/$(database)/documents/supplierQuotes/$(quoteId)).data.updatedAt == request.time
          && request.resource.data.keys().hasOnly(['revision', 'snapshot', 'previousSnapshot', 'createdAt', 'createdBy'])
          && request.resource.data.snapshot is map && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && (request.resource.data.revision == 1
            || (request.resource.data.snapshot == getAfter(/databases/$(database)/documents/supplierQuotes/$(quoteId)).data
              && request.resource.data.previousSnapshot == get(/databases/$(database)/documents/supplierQuotes/$(quoteId)).data));
        allow update, delete: if false;
      }
      match /items/{itemId} {
        // Integer remainder is removed before division, avoiding floating-point rounding near a yen boundary.
        function floorDivide(n, divisor) { return int((n - n % divisor) / divisor); }
        function tax(amount, category, rate) {
          return category == 'exempt' ? 0 : floorDivide(amount * rate, category == 'inclusive' ? 10000 + rate : 10000);
        }
        function validTax(category, rate) {
          return category in ['exclusive', 'inclusive', 'exempt'] && rate is int
            && rate >= 0 && rate <= 10000 && (category != 'exempt' || rate == 0);
        }
        function amounts(d) {
          let goods = floorDivide(d.quantityMillis * d.unitPrice, 1000);
          let goodsTax = tax(goods, d.taxCategory, d.taxRateBps);
          let shippingTax = tax(d.shippingFee, d.shippingTaxCategory, d.shippingTaxRateBps);
          let base = goods - (d.taxCategory == 'inclusive' ? goodsTax : 0)
            + d.shippingFee - (d.shippingTaxCategory == 'inclusive' ? shippingTax : 0);
          return d.subtotal == base && d.tax == goodsTax + shippingTax && d.total == base + d.tax
            && d.shippingTotal == d.shippingFee + (d.shippingTaxCategory == 'exclusive' ? shippingTax : 0);
        }
        function references(d, header) {
          let item = get(/databases/$(database)/documents/rfqs/$(d.rfqId)/items/$(d.rfqItemId)).data;
          return d.rfqId == header.rfqId && item.archivedAt == null && item.status != 'cancelled'
            && d.productId == (item.productId == '' ? null : item.productId)
            && (header.requestId == null
              || (get(/databases/$(database)/documents/supplierQuoteRequests/$(header.requestId)).data.rfqItemIds.hasAny([d.rfqItemId])
                && get(/databases/$(database)/documents/supplierQuoteRequests/$(header.requestId)).data.status != 'cancelled'));
        }
        function validLine(d) {
          return d.keys().hasAll(['rfqId', 'rfqItemId', 'productId', 'partNumber', 'itemName', 'unit', 'quantity', 'quantityMillis', 'unitPrice', 'shippingFee', 'taxCategory', 'taxRateBps', 'shippingTaxCategory', 'shippingTaxRateBps', 'subtotal', 'tax', 'total', 'shippingTotal', 'deliveryDate', 'note', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
            && d.keys().hasOnly(['rfqId', 'rfqItemId', 'productId', 'partNumber', 'itemName', 'unit', 'quantity', 'quantityMillis', 'unitPrice', 'shippingFee', 'taxCategory', 'taxRateBps', 'shippingTaxCategory', 'shippingTaxRateBps', 'subtotal', 'tax', 'total', 'shippingTotal', 'deliveryDate', 'note', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
            && d.rfqItemId is string && d.rfqItemId.size() > 0 && d.rfqItemId.size() <= 128
            && (d.productId == null || (d.productId is string && d.productId.size() <= 128))
            && d.partNumber is string && d.partNumber.size() <= 200
            && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 500
            && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 50
            && d.quantityMillis is int && d.quantityMillis > 0 && d.quantityMillis <= 1000000000
            && d.quantity is number && d.quantity == d.quantityMillis / 1000.0
            && d.unitPrice is int && d.unitPrice >= 0 && d.unitPrice <= 1000000000
            && d.shippingFee is int && d.shippingFee >= 0 && d.shippingFee <= 1000000000000
            && validTax(d.taxCategory, d.taxRateBps) && validTax(d.shippingTaxCategory, d.shippingTaxRateBps)
            && d.subtotal is int && d.tax is int && d.total is int && d.shippingTotal is int
            && d.total >= 0 && d.total <= 1000000000000 && amounts(d)
            && (d.deliveryDate == null || d.deliveryDate is timestamp)
            && d.note is string && d.note.size() <= 5000
            && d.revision is int && d.revision > 0 && d.createdAt is timestamp && d.createdBy is string
            && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
        }
        function coupled(d) {
          let parent = /databases/$(database)/documents/supplierQuotes/$(quoteId);
          let before = get(parent).data;
          let after = getAfter(parent).data;
          return after.revision == before.revision + 1 && after.updatedAt == request.time
            && after.updatedBy == request.auth.uid && after.lastItemId == itemId
            && before.archivedAt == null && before.status != 'withdrawn'
            && references(d, after) && totalsDelta(after, before)
            && getAfter(/databases/$(database)/documents/supplierQuotes/$(quoteId)/items/$(itemId)/revisions/$(string(d.revision))).data.snapshot == d;
        }
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && validLine(request.resource.data)
          && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid && coupled(request.resource.data);
        allow update: if isSignedIn() && validLine(request.resource.data)
          && request.resource.data.rfqId == resource.data.rfqId && request.resource.data.rfqItemId == resource.data.rfqItemId
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.revision == resource.data.revision + 1 && coupled(request.resource.data);
        allow delete: if false;
        match /revisions/{revisionId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn()
            && request.resource.data.keys().hasOnly(['snapshot', 'createdAt', 'createdBy'])
            && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.snapshot == getAfter(/databases/$(database)/documents/supplierQuotes/$(quoteId)/items/$(itemId)).data
            && revisionId == string(request.resource.data.snapshot.revision)
            && request.resource.data.snapshot.updatedAt == request.time;
          allow update, delete: if false;
        }
      }
    }
    match /marketplaceOffers/{offerId} {
      function floorDivide(n, divisor) { return int((n - n % divisor) / divisor); }
      function validTax(category, rate) {
        return category in ['exclusive', 'inclusive', 'exempt'] && rate is int
          && rate >= 0 && rate <= 10000 && (category != 'exempt' || rate == 0);
      }
      function tax(amount, category, rate) {
        return category == 'exempt' ? 0 : floorDivide(amount * rate, category == 'inclusive' ? 10000 + rate : 10000);
      }
      function validOfferAmounts(d) {
        let goods = floorDivide(d.quantityMillis * d.unitPrice, 1000);
        let goodsTax = tax(goods, d.taxCategory, d.taxRateBps);
        let goodsBase = goods - (d.taxCategory == 'inclusive' ? goodsTax : 0);
        return (d.shippingFee == null
            && d.subtotal == null && d.tax == null && d.total == null
            && d.shippingTotal == null && d.totalPrice == null)
          || (d.shippingFee is int && d.shippingFee >= 0 && d.shippingFee <= 1000000000000
            && d.subtotal == goodsBase + d.shippingFee - (d.shippingTaxCategory == 'inclusive' ? tax(d.shippingFee, d.shippingTaxCategory, d.shippingTaxRateBps) : 0)
            && d.tax == goodsTax + tax(d.shippingFee, d.shippingTaxCategory, d.shippingTaxRateBps)
            && d.total == d.subtotal + d.tax && d.totalPrice == d.total
            && d.shippingTotal == d.shippingFee + (d.shippingTaxCategory == 'exclusive' ? tax(d.shippingFee, d.shippingTaxCategory, d.shippingTaxRateBps) : 0)
            && d.total <= 1000000000000);
      }
      function validMarketplaceOffer(d) {
        let itemPath = /databases/$(database)/documents/rfqs/$(d.rfqId)/items/$(d.rfqItemId);
        let item = get(itemPath).data;
        return d.keys().hasAll(['rfqId', 'rfqItemId', 'source', 'externalItemId', 'sellerName', 'itemName', 'partNumber', 'quantity', 'quantityMillis', 'unit', 'unitPrice', 'shippingFee', 'taxCategory', 'taxRateBps', 'shippingTaxCategory', 'shippingTaxRateBps', 'subtotal', 'tax', 'total', 'shippingTotal', 'totalPrice', 'stockStatus', 'estimatedDeliveryDate', 'itemUrl', 'retrievedAt', 'note', 'productId', 'createdAt', 'createdBy'])
          && d.keys().hasOnly(['rfqId', 'rfqItemId', 'source', 'externalItemId', 'sellerName', 'itemName', 'partNumber', 'quantity', 'quantityMillis', 'unit', 'unitPrice', 'shippingFee', 'taxCategory', 'taxRateBps', 'shippingTaxCategory', 'shippingTaxRateBps', 'subtotal', 'tax', 'total', 'shippingTotal', 'totalPrice', 'stockStatus', 'estimatedDeliveryDate', 'itemUrl', 'retrievedAt', 'note', 'productId', 'createdAt', 'createdBy'])
          && d.rfqId is string && d.rfqId.size() > 0 && d.rfqId.size() <= 128
          && d.rfqItemId is string && d.rfqItemId.size() > 0 && d.rfqItemId.size() <= 128
          && exists(/databases/$(database)/documents/rfqs/$(d.rfqId)) && exists(itemPath)
          && item.archivedAt == null && item.status != 'cancelled'
          && d.productId == (item.productId == '' ? null : item.productId) && d.unit == item.unit
          && d.source in ['amazon', 'rakuten', 'other']
          && d.externalItemId is string && d.externalItemId.size() <= 200
          && d.sellerName is string && d.sellerName.size() <= 200
          && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 500
          && d.partNumber is string && d.partNumber.size() <= 200
          && d.quantityMillis is int && d.quantityMillis > 0 && d.quantityMillis <= 1000000000
          && d.quantity is number && d.quantity == d.quantityMillis / 1000.0
          && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 50
          && d.unitPrice is int && d.unitPrice >= 0 && d.unitPrice <= 1000000000
          && validTax(d.taxCategory, d.taxRateBps) && validTax(d.shippingTaxCategory, d.shippingTaxRateBps)
          && validOfferAmounts(d)
          && d.stockStatus is string && d.stockStatus.size() <= 100
          && (d.estimatedDeliveryDate == null || d.estimatedDeliveryDate is timestamp)
          && (d.itemUrl == null || (d.itemUrl is string && d.itemUrl.size() <= 2000 && d.itemUrl.matches('https?://.+')))
          && d.retrievedAt is timestamp && d.retrievedAt <= request.time
          && d.note is string && d.note.size() <= 5000
          && d.createdAt == request.time && d.createdBy == request.auth.uid;
      }
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && validMarketplaceOffer(request.resource.data);
      allow update, delete: if false;
    }
    match /rfqCounters/{year} {
      function validCounter() {
        let d = request.resource.data;
        return year.matches('[0-9]{4}')
          && d.keys().hasAll(['year', 'nextSequence', 'updatedAt'])
          && d.keys().hasOnly(['year', 'nextSequence', 'updatedAt'])
          && d.year == year && d.nextSequence is int
          && d.nextSequence > 0 && d.nextSequence <= 999999
          && d.updatedAt == request.time;
      }
      allow get: if isSignedIn();
      allow create: if isSignedIn() && validCounter() && request.resource.data.nextSequence == 1;
      allow update: if isSignedIn() && validCounter()
        && request.resource.data.nextSequence == resource.data.nextSequence + 1;
      allow delete, list: if false;
    }
    match /{document=**} {
    // P2-007: only the Admin SDK in callable Functions mutates decisions and their aggregate state.
    match /rfqs/{rfqId}/sourcingStates/{itemId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false;
    }
    match /rfqs/{rfqId}/items/{itemId}/sourcingDecisions/{decisionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }
      allow read, write: if false;
    }
  }
}
